{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-cap",
  "description": "Main window capability: core defaults + dialog/opener; deny-by-default otherwise (note 12 security posture).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default"
  ]
}
