{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "还我磁盘 Giveback",
  "version": "0.1.0",
  "identifier": "com.giveback.diskjanitor",
  "build": {
    "beforeDevCommand": "cd ../app && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../app && bun run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "还我磁盘 Giveback",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["main-cap"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.svg"]
  }
}
